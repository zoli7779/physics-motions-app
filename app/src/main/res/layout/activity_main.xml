<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cím és Nyelvváltó gomb -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnLanguageToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_toggle_lang"
            android:contentDescription="@string/accessibility_lang_toggle"
            android:layout_marginBottom="16dp" />

        <!-- 1. Egyenes vonalú, egyenletes mozgás -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_uniform_linear"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/desc_uniform_linear"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/formula_uniform_linear"
            android:textSize="13sp"
            android:textStyle="italic"
            android:layout_marginBottom="16dp" />

        <!-- 2. Egyenes vonalú, egyenletesen gyorsuló mozgás -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_accelerated_linear"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/desc_accelerated_linear"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/formula_accelerated_linear"
            android:textSize="13sp"
            android:textStyle="italic"
            android:layout_marginBottom="16dp" />

        <!-- 3. Egyenletes körmozgás -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_uniform_circular"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/desc_uniform_circular"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/formula_uniform_circular"
            android:textSize="13sp"
            android:textStyle="italic"
            android:layout_marginBottom="16dp" />

        <!-- 4. Szabadesés -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_free_fall"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/desc_free_fall"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/formula_free_fall"
            android:textSize="13sp"
            android:textStyle="italic"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>